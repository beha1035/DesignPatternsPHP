      { "channel": "Booking.com", "tier": 3, "implemented": false, "note": "largest inventory; Genius member discount when signed in" },
      { "channel": "Direct hotel site", "tier": 3, "implemented": false, "note": "often matches/beats OTAs with member rates (Frommer's)" },
      { "channel": "Trivago", "tier": 3, "implemented": false, "note": "metasearch across 400+ sites" }
    ]
  },

