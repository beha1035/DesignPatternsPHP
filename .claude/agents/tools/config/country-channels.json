    { "title": "Frommer's — Best & worst hotel booking sites 2026", "url": "https://www.frommers.com/slideshows/819303-best-and-worst-hotel-booking-sites-for-2026/" },
    { "title": "PhocusWire — Middle East distribution series", "url": "https://www.phocuswire.com/Middle-East-series-part-3-distribution" },
    { "title": "MenaBytes — Travel websites MENA", "url": "https://www.menabytes.com/travel-websites-mena/" },
    { "title": "Aggregate Intelligence — Asia's top OTAs (PDF)", "url": "https://aggregateintelligence.com/wp-content/uploads/2025/04/What-Asias-Top-OTAs-Offer-A-Deep-Dive.pdf" },
    { "title": "Despegar — Wikipedia (LatAm leader)", "url": "https://en.wikipedia.org/wiki/Despegar" }
  ],
  "_tierLegend": {
    "0": "structured API (google-hotels-rate; apify with key) — fast, broad",
    "1": "browserless HTTP tool (e.g. tunisiebooking-rate) — fast, free, local depth",
    "2": "managed unblocker (brightdata) — keyed",
    "3": "self-hosted browser (validate-rate) — last resort"
  },

  "default": {
    "note": "Global baseline where no strong local OTA beats the giants (most of Europe & North America): compare metasearch + Booking (Genius when logged in) + direct rate.",
    "channels": [
