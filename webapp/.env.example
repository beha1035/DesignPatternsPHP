# Copy to .env (gitignored) and fill in real values. NEVER commit real
# secrets. The server refuses to start without API_BEARER_TOKEN set.

# Required — static internal bearer token for the API (defense in depth; the
# server must also stay bound to localhost/VPN, see docs/ARCHITECTURE-MULTIAGENT.md §7).
API_BEARER_TOKEN=change-me-to-a-long-random-value

# Optional — bind address/port.
HOST=127.0.0.1
PORT=3000

# Optional — enables the Apify breadth channel (Tier 0 signal) inside
# find-best-rate.mjs. Without it, the app still works fully for Tunisia
# (TunisieBooking, verified, free).
# APIFY_TOKEN=apify_api_xxx
# APIFY_HOTEL_ACTOR=voyager~booking-scraper

# Optional — enables Google Hotels (SerpApi) as an additional signal.
# SERPAPI_KEY=xxx
